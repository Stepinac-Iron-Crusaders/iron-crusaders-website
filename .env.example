# Copy to .env.local and fill in real values. Never commit .env.local.
#
# These are safe to expose to the browser: VITE_SUPABASE_PUBLISHABLE_KEY is
# the publishable (anon) key, which cannot bypass Row Level Security. The
# service_role key must never be used here or shipped to the frontend.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here